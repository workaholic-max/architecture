{
    "name": "architecture",
    "version": "1.0.0",
    "type": "module",
    "private": true,
    "scripts": {
        "preinstall": "npx only-allow pnpm",
        "type:check": "vue-tsc --noEmit",
        "watch": "vite --mode local-development",
        "build": "pnpm type:check && vite build --mode production",
        "build-dev": "pnpm type:check && vite build --mode development",
        "build-local": "pnpm type:check && vite build --mode local-development",
        "preview": "vite preview",
        "lint:check": "eslint \"src/**/*.{js,ts,vue}\"",
        "lint:fix": "eslint --fix \"src/**/*.{js,ts,vue}\"",
        "format:check": "prettier --check \"**/*.{js,ts,vue,scss,css,html,json,md}\"",
        "format:fix": "prettier --write \"**/*.{js,ts,vue,scss,css,html,json,md}\"",
        "prepare": "husky"
    },
    "lint-staged": {
        "*.{js,ts,vue,scss,html,json,md}": "prettier --write",
        "src/**/*.{js,ts,vue}": "eslint --fix"
    },
    "dependencies": {
        "axios": "^1.16.0",
        "chart.js": "^4.5.1",
        "pinia": "^3.0.4",
        "vue": "^3.5.17",
        "vue-router": "^4.5.1"
    },
    "devDependencies": {
        "@eslint/js": "^9.31.0",
        "@vitejs/plugin-vue": "^6.0.1",
        "eslint": "^9.31.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-simple-import-sort": "^12.1.1",
        "eslint-plugin-unused-imports": "^4.1.4",
        "eslint-plugin-vue": "^10.3.0",
        "eslint-plugin-vuejs-accessibility": "^2.5.0",
        "globals": "^17.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.6.2",
        "sass": "^1.93.2",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.59.2",
        "unplugin-auto-import": "^21.0.0",
        "vite": "^7.3.2",
        "vue-eslint-parser": "^10.2.0",
        "vue-tsc": "^3.2.8"
    },
    "pnpm": {
        "overrides": {
            "postcss": "^8.5.10",
            "rollup": "^4.59.0",
            "minimatch": "^3.1.4",
            "flatted": "^3.4.2",
            "picomatch": "^4.0.4",
            "immutable": "^5.1.5",
            "brace-expansion": "^1.1.13",
            "ajv": "^6.14.0"
        },
        "onlyBuiltDependencies": [
            "@parcel/watcher",
            "esbuild",
            "unrs-resolver"
        ]
    }
}
